# Copy thành `.env` (local) hoặc điền trên Render Dashboard → Environment

# Bắt buộc — NextAuth
AUTH_SECRET=thay-bang-chuoi-ngau-nhien-dai
AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook OAuth (tuỳ chọn) — https://developers.facebook.com/
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=

# Email giáo viên (admin), cách nhau bằng dấu phẩy
ADMIN_EMAILS=your@gmail.com

# Database SQLite (local)
DATABASE_URL=file:./dev.db

# --- Render (tự set trong render.yaml, không cần copy) ---
# DATA_DIR=/var/data
# DATABASE_URL=file:/var/data/app.db
# UPLOAD_DIR=/var/data/uploads
# AUTH_TRUST_HOST=true
