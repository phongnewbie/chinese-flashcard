# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database
dev.db
dev.db-journal

# uploaded audio/images (local dev only)
public/uploads/audio/*
!public/uploads/audio/.gitkeep
public/uploads/images/*
!public/uploads/images/.gitkeep

# agent/editor tooling (not part of app)
.agents/
.claude/
.windsurf/
skills-lock.json
